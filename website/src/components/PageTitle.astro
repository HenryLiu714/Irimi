---
import Default from '@astrojs/starlight/components/PageTitle.astro';

const id = Astro.locals.starlightRoute.entry.id;
const isDoc = id === 'docs' || id.startsWith('docs/');
const mdHref = isDoc ? `/${id === 'docs' ? 'docs/index' : id}.md` : null;
---

<Default />
{
	mdHref && (
		<div class="page-actions">
			<button type="button" class="copy-md" data-href={mdHref}>
				<span class="label" aria-live="polite">Copy page as Markdown</span>
			</button>
			<a href={mdHref}>View as Markdown</a>
		</div>
	)
}

<style>
	.page-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		align-items: center;
		margin-top: 0.75rem;
		font-size: var(--sl-text-sm);
	}
	.copy-md {
		font: inherit;
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		padding: 0.3rem 0.7rem;
		cursor: pointer;
	}
	.copy-md:hover {
		border-color: var(--sl-color-accent);
	}
	.page-actions a {
		color: var(--sl-color-gray-2);
	}
</style>

<script>
	// Safari only allows a clipboard write during the click itself, so the Markdown is fetched on load
	// and the click writes it at once. A failed copy says so and leaves the reader on the page.
	for (const button of document.querySelectorAll<HTMLButtonElement>('.copy-md')) {
		const label = button.querySelector('.label')!;
		const markdown = fetch(button.dataset.href!).then((r) => {
			if (!r.ok) throw new Error(`${r.status}`);
			return r.text();
		});
		markdown.catch(() => {});
		const show = (text: string) => {
			label.textContent = text;
			setTimeout(() => (label.textContent = 'Copy page as Markdown'), 2500);
		};
		button.addEventListener('click', async () => {
			try {
				if (typeof ClipboardItem !== 'undefined' && navigator.clipboard.write) {
					const blob = markdown.then((t) => new Blob([t], { type: 'text/plain' }));
					await navigator.clipboard.write([new ClipboardItem({ 'text/plain': blob })]);
				} else {
					await navigator.clipboard.writeText(await markdown);
				}
				show('Copied');
			} catch {
				show("Couldn't copy: use View as Markdown");
			}
		});
	}
</script>
